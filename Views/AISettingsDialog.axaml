<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Mermaider.ViewModels"
        xmlns:models="using:Mermaider.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="500"
        x:Class="Mermaider.Views.AISettingsDialog"
        x:DataType="vm:AISettingsViewModel"
        Title="AI 模型设置"
        Width="600" Height="500"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Design.DataContext>
        <vm:AISettingsViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="*,Auto" Margin="16">
        <ScrollViewer Grid.Row="0">
            <StackPanel Spacing="16">
                <TextBlock Text="AI 模型配置" FontSize="16" FontWeight="Bold" Foreground="#333333"/>

                <TextBlock Text="已配置的模型" FontSize="14" FontWeight="SemiBold" Foreground="#333333"/>

                <ItemsControl ItemsSource="{Binding ModelConfigs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:AIModelConfig">
                            <Border Background="#F8F8F8" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock FontSize="11" Foreground="#666666">
                                            <Run Text="{Binding Provider}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding ModelId}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <Button Content="编辑" FontSize="11" Padding="8,4"
                                                Background="#E3F2FD" BorderThickness="0" CornerRadius="4"
                                                Command="{Binding $parent[ItemsControl].((vm:AISettingsViewModel)DataContext).EditModelCommand}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="删除" FontSize="11" Padding="8,4"
                                                Background="#FFEBEE" BorderThickness="0" CornerRadius="4"
                                                Command="{Binding $parent[ItemsControl].((vm:AISettingsViewModel)DataContext).DeleteModelCommand}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="+ 添加新模型" HorizontalAlignment="Stretch"
                        FontSize="13" Padding="12,8"
                        Background="#E8F5E9" BorderThickness="1" BorderBrush="#C8E6C9"
                        CornerRadius="6" Cursor="Hand"
                        Command="{Binding AddModelCommand}"/>

                <Border Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="12"
                        IsVisible="{Binding IsEditing}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding EditPanelTitle}" FontSize="14" FontWeight="SemiBold" Foreground="#333333"/>

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Text="{Binding EditingName}" Watermark="模型名称（如：GPT-4o）"/>
                        </Grid>

                        <StackPanel Spacing="4">
                            <TextBlock Text="服务类型" FontSize="12" Foreground="#666666"/>
                            <ComboBox ItemsSource="{Binding ProviderTypes}" SelectedItem="{Binding EditingProvider}"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <StackPanel Spacing="4" IsVisible="{Binding IsApiKeyRequired}">
                            <TextBlock Text="API Key" FontSize="12" Foreground="#666666"/>
                            <TextBox Text="{Binding EditingApiKey}" PasswordChar="●" Watermark="sk-..."/>
                        </StackPanel>

                        <StackPanel Spacing="4" IsVisible="{Binding IsBaseUrlRequired}">
                            <TextBlock Text="Base URL" FontSize="12" Foreground="#666666"/>
                            <TextBox Text="{Binding EditingBaseUrl}" Watermark="https://api.example.com/v1"/>
                        </StackPanel>

                        <StackPanel Spacing="4" IsVisible="{Binding IsAzureConfig}">
                            <TextBlock Text="Endpoint" FontSize="12" Foreground="#666666"/>
                            <TextBox Text="{Binding EditingEndpoint}" Watermark="https://your-resource.openai.azure.com"/>
                            <TextBlock Text="Deployment Name" FontSize="12" Foreground="#666666" Margin="0,8,0,0"/>
                            <TextBox Text="{Binding EditingDeploymentName}"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Model ID" FontSize="12" Foreground="#666666"/>
                            <TextBox Text="{Binding EditingModelId}" Watermark="gpt-4o"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="高级选项" FontSize="12" Foreground="#666666"/>
                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Max Tokens" FontSize="11" Foreground="#888888"/>
                                    <NumericUpDown Value="{Binding EditingMaxTokens}" Minimum="100" Maximum="32000" Width="120"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4" Margin="16,0,0,0">
                                    <TextBlock Text="Temperature" FontSize="11" Foreground="#888888"/>
                                    <NumericUpDown Value="{Binding EditingTemperature}" Minimum="0" Maximum="2" Increment="0.1" Width="120"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="取消" Width="80" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    Command="{Binding CancelEditCommand}"/>
                            <Button Content="保存" Width="80" Background="#3B82F6" Foreground="White"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    Command="{Binding SaveModelCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Spacing="8">
                    <TextBlock Text="对话历史存储" FontSize="14" FontWeight="SemiBold" Foreground="#333333"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Text="{Binding ConversationStoragePath}"
                                 Watermark="默认: %AppData%/Mermaider/Conversations"/>
                        <Button Grid.Column="1" Content="浏览" Width="60" Margin="8,0,0,0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Command="{Binding BrowseStoragePathCommand}"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="关闭" Width="80" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Command="{Binding CloseCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
