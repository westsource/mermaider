sequenceDiagram
    participant U as 用户
    participant MW as MainWindow
    participant VM as MainViewModel
    participant FS as FileService
    participant T as TabItem
    participant WV as WebView

    alt 菜单打开文件
        U->>MW: 点击 文件 → 打开
        MW->>VM: OpenFileCommand
        VM->>FS: OpenFileAsync()
        FS->>FS: 显示文件选择对话框
        FS-->>VM: (content, filePath)
    else 命令行参数打开
        Note over VM: OpenFileFromPath(filePath)
        VM->>FS: OpenFileFromPathAsync(filePath)
        FS->>FS: 读取文件内容
        FS-->>VM: content
    else 最近文件打开
        U->>MW: 点击 最近文件
        MW->>VM: OpenRecentFileCommand
        VM->>VM: OpenFileFromPath(filePath)
        VM->>FS: OpenFileFromPathAsync(filePath)
        FS-->>VM: content
    end

    rect rgb(255, 250, 240)
        Note over VM: 检查文件是否已打开
        VM->>VM: TrySelectExistingTabByPath(filePath)
        alt 文件已在标签页中打开
            VM->>VM: SelectedTabIndex = existingIndex
            VM-->>U: 切换到已存在的标签页
        else 文件未打开
            VM->>T: new TabItem{Content, FilePath}
            T->>T: UpdateHeader()
            VM->>VM: Tabs.Add(tab)
            VM->>VM: SelectedTabIndex = Tabs.Count - 1
            VM->>VM: AddToRecentFiles(filePath)
        end
    end

    rect rgb(240, 255, 240)
        Note over VM: 验证并渲染标签页
        VM->>VM: ValidateAndRenderTab(tab)
        
        alt Content 为空
            VM->>VM: tab.WebPreviewHtml = BuildPreviewHtml("")
            Note over VM: 不触发 WebView 创建
        else Content 不为空
            VM->>VM: tab.WebPreviewHtml = BuildPreviewHtml(content)
            VM->>VM: CurrentPreviewHtml = tab.WebPreviewHtml
            Note over VM: 触发 PropertyChanged 事件
        end
    end

    VM-->>MW: PropertyChanged(CurrentPreviewHtml)
    MW->>MW: OnViewModelPropertyChanged
    MW->>MW: UpdateWebPreview()

    rect rgb(240, 248, 255)
        Note over MW: WebView 初始化检查
        MW->>MW: 检查 Content 是否为空
        alt Content 为空且 WebView 未创建
            MW-->>U: 返回，不创建 WebView
        else Content 不为空
            MW->>MW: EnsureWebViewReady()
            alt WebView 未创建
                MW->>WV: new WebView()
                MW->>WV: AttachedToVisualTree
                MW->>MW: TryApplyPendingWebPreview()
            else WebView 已存在
                MW->>MW: TryApplyPendingWebPreview()
            end
        end
    end

    rect rgb(255, 245, 238)
        Note over MW: 应用预览内容
        MW->>MW: EnsurePreviewFilesReady()
        Note over MW: 复制 mermaid.min.js 到临时目录
        MW->>MW: 写入 preview.html
        MW->>WV: Navigate(previewUri + ?t=timestamp)
    end

    WV->>WV: 加载 HTML
    WV->>WV: 执行 JavaScript
    Note over WV: mermaid.render(code)
    WV->>WV: 显示 Mermaid 图表
    WV-->>U: 预览区域显示图表
