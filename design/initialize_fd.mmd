flowchart TD
    Start([程序启动]) --> RegHandler["注册异常处理器<br/>AppDomain.CurrentDomain.UnhandledException"]
    RegHandler --> BuildApp["Program.BuildAvaloniaApp()"]
    
    subgraph AppInit[App 初始化阶段]
        BuildApp --> RegServices["App.RegisterServices()<br/>AvaloniaWebViewBuilder.Initialize()"]
        RegServices --> InitXaml["App.Initialize()<br/>AvaloniaXamlLoader.Load()"]
        InitXaml --> FrameworkInit["App.OnFrameworkInitializationCompleted()"]
    end
    
    subgraph CreateServices[创建服务层]
        FrameworkInit --> CreateMermaid["new MermaidService()"]
        CreateMermaid --> CreateSettings["new SettingsService()"]
        CreateSettings --> CreateFile["new FileService()"]
    end
    
    CreateFile --> CreateMainWindow["new MainWindow()"]
    CreateMainWindow --> CreateViewModel["new MainViewModel(...)"]
    
    subgraph VMInit[MainViewModel 初始化]
        CreateViewModel --> LoadSettings["加载用户设置<br/>SettingsService.Settings"]
        LoadSettings --> LoadRecentFiles["加载最近文件列表<br/>SettingsService.CleanInvalidRecentFiles()"]
        LoadRecentFiles --> AddNewTab["MainViewModel.AddNewTab()"]
        AddNewTab --> CreateTab["new TabItem{Content = string.Empty}"]
        CreateTab --> TabAdd["Tabs.Add(tab)"]
        TabAdd --> SelectTab["SelectTab(Tabs.Count - 1)"]
        SelectTab --> CheckContent{Content 是否为空?}
        CheckContent -->|是| SkipWebView["不触发 WebView 创建<br/>ValidateAndRenderTab 直接返回"]
        CheckContent -->|否| ScheduleRender["ScheduleValidationAndRender(tab)"]
    end
    
    SkipWebView --> SetDataContext["mainWindow.DataContext = viewModel"]
    ScheduleRender --> SetDataContext
    SetDataContext --> OnDCChanged["MainWindow.OnDataContextChanged()"]
    
    subgraph MWInit[MainWindow 初始化]
        OnDCChanged --> SubViewModel["_viewModel.PropertyChanged += OnViewModelPropertyChanged"]
        SubViewModel --> RefreshEditor["RefreshEditorState()"]
        RefreshEditor --> UpdateLayout["UpdateWorkspaceLayout()"]
        UpdateLayout --> UpdatePreview["UpdateWebPreview()"]
        UpdatePreview --> CheckContent2{Content 是否为空?}
        CheckContent2 -->|是| SkipInit["跳过 WebView 初始化<br/>直接 return"]
        CheckContent2 -->|否| InitWebView["EnsureWebViewReady()"]
    end
    
    subgraph WebViewInit[WebView 初始化]
        InitWebView --> CheckBounds{"_previewWebHost.Bounds<br/>Width/Height > 0?"}
        CheckBounds -->|否| DelayInit["延迟初始化<br/>return false"]
        CheckBounds -->|是| CreateWV["new WebView()"]
        CreateWV --> SetProps["设置 HorizontalAlignment/VerticalAlignment"]
        SetProps --> AttachEvent["AttachedToVisualTree += 事件"]
        AttachEvent --> SetChild["_previewWebHost.Child = webViewControl"]
    end
    
    DelayInit --> CheckArgs
    SetChild --> CheckArgs
    
    CheckArgs{"命令行参数<br/>args.Length > 1?"}
    CheckArgs -->|是| OpenFile["viewModel.OpenFileFromPath(args[1])"]
    CheckArgs -->|否| SetMainWindow["desktop.MainWindow = mainWindow"]
    OpenFile --> SetMainWindow
    
    SetMainWindow --> ShowWindow([窗口显示完成])
