flowchart TD
    A["Workspace SizeChanged 事件触发"] --> B["OnWorkspaceSizeChanged()"]

    B --> C["UpdateWorkspaceLayout()"]

    subgraph UpdateWorkspaceLayout["UpdateWorkspaceLayout() 流程"]
        C --> E{"DataContext is MainViewModel?"}
        E -->|否| F["return"]
        E -->|是| G["获取窗口宽度 Bounds.Width"]
        G --> H{"width > 0?"}
        H -->|否| F
        H -->|是| I["调用 viewModel.UpdateWorkspaceLayout(width)"]
    end

    subgraph ViewModelUpdate["MainViewModel.UpdateWorkspaceLayout()"]
        I --> J{"totalWidth <= 0?"}
        J -->|是| K["return"]
        J -->|否| L["计算可用宽度<br/>usableWidth = totalWidth - splitterWidth(5)"]
        L --> M["计算目标宽度<br/>targetWidth = usableWidth * EditorPreviewRatio"]
        M --> N["限制编辑器宽度范围<br/>editorWidth = Clamp(targetWidth, 420, 860)"]
        N --> O{"usableWidth - editorWidth < minPreviewWidth(480)?"}
        O -->|是| P["调整编辑器宽度<br/>editorWidth = Max(320, usableWidth - 480)"]
        O -->|否| Q["保持当前 editorWidth"]
        P --> R["更新 EditorPanelWidth"]
        Q --> R
    end

    R --> D["UpdateWebPreview()"]

    subgraph UpdateWebPreview["UpdateWebPreview() 流程"]
        D --> S{"_viewModel == null or<br/>_previewWebHost == null?"}
        S -->|是| T["return"]
        S -->|否| U{"CurrentTab?.Content<br/>为空且 WebView 未创建?"}
        U -->|是| V["推迟创建 WebView"]
        U -->|否| W["EnsureWebViewReady()"]
        W --> X{"WebView 初始化成功?"}
        X -->|否| Y["设置状态: WebView 初始化失败"]
        X -->|是| Z["获取 CurrentPreviewHtml"]
        Z --> AA{"html 为空?"}
        AA -->|是| T
        AA -->|否| AB["设置 _pendingPreviewHtml"]
        AB --> AC["TryApplyPendingWebPreview()"]
    end

    AC --> AD["界面布局更新完成"]
