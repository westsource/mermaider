flowchart TD
    A["用户编辑代码"] --> B["OnTabContentChanged"]
    B --> C["tab.CachedPngBytes = null<br/>（失效化旧缓存）"]
    C --> D["ScheduleValidationAndRender<br/>（350ms 防抖）"]

    D --> E{"ValidateAndRenderTab"}
    E --> F["BuildPreviewHtml → WebView 更新"]
    F --> G["StatusMessage = 'Preview updated'"]
    G --> H["ScheduleBackgroundImageGeneration<br/>（800ms 延迟）"]

    H --> I{"GenerateBackgroundImageAsync"}
    I --> J["CountDiagramElements → 元素数"]
    J --> K["CalculateScale → 动态缩放倍数"]
    K --> L["MermaidService.RenderAndValidateAsync"]
    L --> M{"成功？"}
    M -->|是| N["tab.CachedPngBytes = result"]
    M -->|否| O["静默失败（不影响用户操作）"]

    N --> P["旧 byte[] 无引用 → GC 自动回收"]
