flowchart TD
    A["用户点击「复制图片」或「保存图片」"] --> B{"RenderHighQualityPreviewAsync"}

    B --> C["tab.CachedPngBytes != null？"]
    C -->|是| D["直接返回缓存 byte[]<br/>（O(1)，无 CLI 调用）"]
    C -->|否| E["CountDiagramElements → 元素数"]
    E --> F["CalculateScale → 动态缩放倍数"]
    F --> G["MermaidService.RenderAndValidateAsync<br/>（同步 fallback，极罕见）"]
    G --> H{"成功？"}

    H -->|是| I["返回 ImageData"]
    H -->|否| J["显示错误信息"]

    D --> K["CopyImage / SaveImage"]
    I --> K

    K --> L{"CopyImage?"}
    L -->|是| M["设置 DataObject → Clipboard"]
    L -->|否| N["FileService.SaveImageAsync<br/>→ 保存对话框 → 写文件"]

    M --> O["StatusMessage = 'Image copied to clipboard'"]
    N --> P["StatusMessage = 'Image saved'"]
